---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${frontmatter.title} — Sebastian Mathai`} description={frontmatter.description}>
  <article class="reading">
    <a class="text-link" href={`${base}/articles/`}>← All articles</a>
    <header class="article-header"><p class="eyebrow">{frontmatter.category}</p><h1>{frontmatter.title}</h1><p class="lead">{frontmatter.description}</p><p class="meta">Sebastian Mathai · {frontmatter.date} · {frontmatter.readingTime}</p></header>
    <div class="prose"><slot /></div>
    <div class="article-end"><p>Keep asking why.</p><a class="text-link" href={`${base}/articles/`}>Back to the notebook →</a></div>
  </article>
</Base>
